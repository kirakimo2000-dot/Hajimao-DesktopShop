<UserControl x:Class="HajimaoDesktopShop.Desktop.Controls.ShopSceneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Focusable="False"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <Grid Background="{DynamicResource Brush.Background}" ClipToBounds="True">
        <skia:SKElement x:Name="SceneSurface" PaintSurface="OnPaintSurface" IgnorePixelScaling="True" />
        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="6" Padding="5,2"
                Background="{DynamicResource Brush.OverlaySurface}"
                BorderBrush="{DynamicResource Brush.Primary}" BorderThickness="1"
                IsHitTestVisible="False">
            <TextBlock Text="HAJIMAO 24H" FontFamily="Consolas" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Primary}" FontSize="12" />
        </Border>
    </Grid>
</UserControl>
