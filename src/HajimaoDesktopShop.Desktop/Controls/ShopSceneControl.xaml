<UserControl x:Class="HajimaoDesktopShop.Desktop.Controls.ShopSceneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Focusable="False"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <Grid Background="#17191D" ClipToBounds="True">
        <skia:SKElement x:Name="SceneSurface" PaintSurface="OnPaintSurface" IgnorePixelScaling="True" />
        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="6" Padding="5,2"
                Background="#D917191D" BorderBrush="#8A6B5A" BorderThickness="1"
                IsHitTestVisible="False">
            <TextBlock Text="HAJIMAO 24H" FontFamily="Consolas" FontWeight="Bold"
                       Foreground="#F1B844" FontSize="11" />
        </Border>
    </Grid>
</UserControl>
