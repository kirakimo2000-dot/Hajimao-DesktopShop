<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyTitle>Hajimao DesktopShop</AssemblyTitle>
    <Product>Hajimao DesktopShop</Product>
    <Description>Pixel-style Windows desktop idle market management game.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HajimaoDesktopShop.Application\HajimaoDesktopShop.Application.csproj" />
    <ProjectReference Include="..\HajimaoDesktopShop.Infrastructure\HajimaoDesktopShop.Infrastructure.csproj" />
    <ProjectReference Include="..\HajimaoDesktopShop.Rendering\HajimaoDesktopShop.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Config\products.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
