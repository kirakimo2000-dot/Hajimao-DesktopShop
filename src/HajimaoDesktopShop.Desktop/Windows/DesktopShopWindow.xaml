<Window x:Class="HajimaoDesktopShop.Desktop.Windows.DesktopShopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HajimaoDesktopShop.Desktop.Controls"
        xmlns:desktop="clr-namespace:HajimaoDesktopShop.Desktop"
        Title="{x:Static desktop:ProductIdentity.DesktopWindowTitle}"
        Width="248" Height="180"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource Brush.Text}"
        Topmost="True" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="SurfaceHitTarget" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FocusFrame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusFrame" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FocusFrame" Property="BorderBrush" Value="{DynamicResource Brush.OverlayBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="SurfaceRoot" Background="{DynamicResource Brush.Background}" MouseLeftButtonDown="OnSurfaceMouseLeftButtonDown">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="打开经营管理" Click="OnOpenManagementClick" />
                <MenuItem Header="锁定 / 解锁位置"
                          Command="{Binding PlacementTarget.DataContext.ToggleLockCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem Header="切换鼠标穿透"
                          Command="{Binding PlacementTarget.DataContext.ToggleClickThroughCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            </ContextMenu>
        </Grid.ContextMenu>

        <Grid x:Name="StreetPage"
              Visibility="{Binding DesktopNavigation.IsStreet, Converter={StaticResource BooleanToVisibilityConverter}}">
            <controls:CommercialStreetSceneControl x:Name="StreetScene"
                                                   Frame="{Binding CommercialStreet.SceneFrame}"
                                                   StorefrontClicked="OnStorefrontClicked" />
            <Border x:Name="IdleFeedbackBar"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Margin="6,5,6,0"
                    Padding="8,4"
                    Background="{DynamicResource Brush.OverlaySurface}"
                    BorderBrush="{DynamicResource Brush.OverlayBorder}"
                    BorderThickness="2"
                    IsHitTestVisible="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CashText}"
                               Foreground="{DynamicResource Brush.Primary}"
                               FontFamily="Consolas"
                               FontWeight="Bold"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding IdleFeedback.SessionProfitShortText}"
                               Tag="{Binding IdleFeedback.ProfitTone}"
                               Style="{DynamicResource FeedbackMetricText}"
                               FontSize="12"
                               Margin="8,0,0,0" />
                </Grid>
            </Border>
            <Border x:Name="StreetEventPopup"
                    VerticalAlignment="Top"
                    Margin="6,38,6,0"
                    Padding="8,5"
                    Panel.ZIndex="2"
                    Background="{DynamicResource Brush.OverlaySurface}"
                    BorderBrush="{DynamicResource Brush.OverlayBorder}"
                    BorderThickness="2"
                    IsHitTestVisible="False"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="特殊事件"
                    Visibility="{Binding EventTicker.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding EventTicker.Text}"
                           Foreground="{DynamicResource Brush.Text}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding EventTicker.Text}" />
            </Border>
        </Grid>

        <Grid x:Name="StorePage"
              Visibility="{Binding DesktopNavigation.IsStore, Converter={StaticResource BooleanToVisibilityConverter}}">
            <controls:CombatDesktopShopSurfaceControl x:Name="StoreSurface"
                                                      Frame="{Binding CombatDesktopFrame}" />
            <Canvas>
                <Button Canvas.Left="6" Canvas.Top="4" Width="78" Height="44"
                        Style="{DynamicResource SurfaceActionButton}"
                        Content="← 街区"
                        Command="{Binding DesktopNavigation.BackToStreetCommand}"
                        ToolTip="返回街区"
                        AutomationProperties.Name="返回街区" />
                <Button Canvas.Left="310" Canvas.Top="4" Width="46" Height="44"
                        Style="{StaticResource SurfaceHitTarget}"
                        Command="{Binding ToggleLockCommand}"
                        ToolTip="锁定或解锁窗口位置"
                        AutomationProperties.Name="锁定或解锁窗口位置" />
                <Button Canvas.Left="364" Canvas.Top="4" Width="50" Height="44"
                        Style="{StaticResource SurfaceHitTarget}"
                        Click="OnOpenManagementClick"
                        ToolTip="打开经营管理窗口"
                        AutomationProperties.Name="打开经营管理窗口" />
                <Button Canvas.Left="364" Canvas.Top="232" Width="50" Height="44"
                        Style="{StaticResource SurfaceHitTarget}"
                        Click="OnClickThroughClick"
                        ToolTip="开启前先打开管理窗口，便于恢复鼠标交互"
                        AutomationProperties.Name="切换鼠标穿透" />
            </Canvas>
        </Grid>
    </Grid>
</Window>
