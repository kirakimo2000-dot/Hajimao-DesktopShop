<Window x:Class="HajimaoDesktopShop.Desktop.Windows.ManagementWindow"
        x:Name="ManagementRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HajimaoDesktopShop.Desktop.Controls"
        xmlns:desktop="clr-namespace:HajimaoDesktopShop.Desktop"
        xmlns:market="clr-namespace:HajimaoDesktopShop.Desktop.ViewModels.Market"
        Title="{x:Static desktop:ProductIdentity.ManagementWindowTitle}"
        Width="1180" Height="720" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,2">
            <Grid Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Static desktop:ProductIdentity.BrandHeader}" FontFamily="Consolas"
                               FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" />
                    <TextBlock Text="桌面挂机战斗经营" FontSize="12"
                               Foreground="{DynamicResource Brush.TextMuted}" />
                </StackPanel>
                <StackPanel x:Name="TopMetricsPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="现金" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding CashText}" Style="{DynamicResource MetricText}" FontSize="18" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="本次挂机" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding IdleFeedback.SessionProfitShortText}"
                                   Tag="{Binding IdleFeedback.ProfitTone}"
                                   Style="{DynamicResource FeedbackMetricText}"
                                   FontSize="16" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="回到挂机街区"
                            Style="{DynamicResource PrimaryPixelButton}"
                            Click="OnReturnToStreetClick"
                            AutomationProperties.Name="关闭经营窗口并返回桌面挂机街区" />
                    <Button Tag="desktop-control" Content="鼠标穿透"
                            Style="{DynamicResource UtilityPixelButton}"
                            Margin="8,0,0,0"
                            Command="{Binding ToggleClickThroughCommand}"
                            AutomationProperties.Name="切换桌面挂机鼠标穿透" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="168" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="272" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,2,0" Padding="8">
                <StackPanel>
                    <TextBlock Text="店铺决策" Style="{DynamicResource EyebrowText}" Margin="8,8,8,10" />
                    <Grid>
                        <Button Tag="management-navigation" Content="挂机成果"
                                Style="{DynamicResource NavigationPixelButton}"
                                MinHeight="44"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static market:ManagementSection.Overview}" />
                        <Border x:Name="OverviewSelectionIndicator" Width="5"
                                HorizontalAlignment="Left" Margin="2"
                                Background="{DynamicResource Brush.Primary}"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsOverviewSection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <Grid Margin="0,7,0,0">
                        <Button Tag="management-navigation" Content="战斗策略"
                                Style="{DynamicResource NavigationPixelButton}"
                                MinHeight="44"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static market:ManagementSection.Strategy}" />
                        <Border x:Name="StrategySelectionIndicator" Width="5"
                                HorizontalAlignment="Left" Margin="2"
                                Background="{DynamicResource Brush.Primary}"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsStrategySection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <Grid Margin="0,7,0,0">
                        <Button Tag="management-navigation" Content="新增店铺"
                                Style="{DynamicResource NavigationPixelButton}"
                                MinHeight="44"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static market:ManagementSection.Investment}" />
                        <Border x:Name="InvestmentSelectionIndicator" Width="5"
                                HorizontalAlignment="Left" Margin="2"
                                Background="{DynamicResource Brush.Primary}"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsInvestmentSection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid x:Name="ManagementContent" Grid.Column="1" MinWidth="440" Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="196" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{DynamicResource PixelPanel}" Padding="0">
                    <controls:CombatShopSceneControl x:Name="LiveScene"
                                                     Frame="{Binding CombatDesktopFrame.Scene}"
                                                     AutomationProperties.Name="实时像素店铺场景" />
                </Border>

                <Border Grid.Row="2" Style="{DynamicResource PixelPanel}" Padding="12">
                    <Grid>
                        <ScrollViewer Visibility="{Binding IsOverviewSection, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel>
                                        <TextBlock Text="具体店铺" Style="{DynamicResource EyebrowText}" />
                                        <TextBlock Text="{Binding SelectedStoreName}" Style="{DynamicResource PageTitleText}"
                                                   Foreground="{DynamicResource Brush.Primary}" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Economy.PeriodText}"
                                               Foreground="{DynamicResource Brush.TextMuted}" />
                                </DockPanel>
                                <Border x:Name="IdleRewardPanel"
                                        Style="{DynamicResource SectionCard}"
                                        Background="{DynamicResource Brush.SurfacePrimarySubtle}"
                                        BorderBrush="{DynamicResource Brush.Primary}"
                                        Margin="0,12,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="210" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="这次打开游戏的成果" Style="{DynamicResource EyebrowText}" />
                                            <TextBlock Text="{Binding IdleFeedback.SessionProfitText}"
                                                       Tag="{Binding IdleFeedback.ProfitTone}"
                                                       Style="{DynamicResource FeedbackMetricText}"
                                                       FontSize="20"
                                                       Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding IdleFeedback.SessionCustomerText}"
                                                       Foreground="{DynamicResource Brush.TextMuted}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IdleFeedback.SessionDropText}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Warning}" />
                                            <TextBlock Text="{Binding IdleFeedback.EscapedCustomerText}"
                                                       Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{DynamicResource SectionCard}"
                                        BorderBrush="{DynamicResource Brush.Success}" Margin="0,12,0,8">
                                    <StackPanel>
                                        <TextBlock Text="累计战果" Style="{DynamicResource EyebrowText}" />
                                        <TextBlock Text="{Binding Economy.PerformanceHeadlineText}" FontSize="17" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Success}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Economy.PerformanceDetailText}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Brush.TextMuted}" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource SectionCard}"
                                        BorderBrush="{DynamicResource Brush.Primary}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="当前状态" Style="{DynamicResource EyebrowText}" />
                                        <TextBlock Text="{Binding Economy.ReasonHeadlineText}" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Primary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Economy.ReasonDetailText}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Brush.TextMuted}" Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding EventTicker.Text}" TextWrapping="Wrap"
                                                   Visibility="{Binding EventTicker.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   Foreground="{DynamicResource Brush.Warning}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource SectionCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="下一家店" Style="{DynamicResource EyebrowText}" />
                                            <TextBlock Text="{Binding Investment.NextInvestmentTitle}" FontWeight="Bold"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Investment.NextInvestmentDetailText}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Brush.TextMuted}" Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding Investment.LatestComparisonText}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Brush.Primary}" FontSize="12" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="选择新店" Style="{DynamicResource PrimaryPixelButton}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="{x:Static market:ManagementSection.Investment}"
                                                Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer Visibility="{Binding IsStrategySection, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="战斗策略" Style="{DynamicResource PageTitleText}" />
                                <TextBlock Text="毛毛会自动投掷装备的商品招待顾客。你只需要调整组合，挂机过程会自动结算收入和掉落。"
                                           TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,5,0,12" />
                                <Border Style="{DynamicResource SectionCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Content="使用推荐组合"
                                                    Style="{DynamicResource PrimaryPixelButton}"
                                                    Command="{Binding Loadout.UseRecommendedLoadoutCommand}"
                                                    Margin="12,0,0,0" />
                                            <StackPanel>
                                                <TextBlock Text="当前装备" Style="{DynamicResource EyebrowText}" />
                                                <TextBlock Text="装备决定招待威力、出手间隔和顾客收益。"
                                                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <ItemsControl x:Name="StoreLoadoutSlots" ItemsSource="{Binding Loadout.Slots}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource Brush.SurfaceElevated}"
                                                            BorderBrush="{DynamicResource Brush.Border}"
                                                            BorderThickness="2" Padding="8" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="52" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding SlotNumber, StringFormat=栏位 {0}}"
                                                                       Foreground="{DynamicResource Brush.TextMuted}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" />
                                                            <TextBlock Grid.Column="2" Text="{Binding SummaryText}"
                                                                       Foreground="{DynamicResource Brush.Primary}" Margin="12,0,0,0" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Loadout.StatusMessage}" Foreground="{DynamicResource Brush.Primary}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="商品图鉴" Style="{DynamicResource EyebrowText}" />
                                <TextBlock Text="招待顾客会随机掉落商品；重复掉落会提升熟练度。"
                                           TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,8" />
                                <ItemsControl x:Name="ProductCollectionList" ItemsSource="{Binding Collection.Products}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Brush.SurfaceElevated}"
                                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="2"
                                                    Padding="9" Margin="0,0,0,7">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding MasteryProgressText}"
                                                                   Foreground="{DynamicResource Brush.TextMuted}" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="装备" MinWidth="74"
                                                            Command="{Binding DataContext.Collection.EquipProductCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding ProductId}" Margin="12,0,0,0" />
                                                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,0">
                                                        <TextBlock Text="{Binding PowerText}" Foreground="{DynamicResource Brush.Primary}" Margin="0,0,14,0" />
                                                        <TextBlock Text="{Binding RevenueText}" Foreground="{DynamicResource Brush.Success}" Margin="0,0,14,0" />
                                                        <TextBlock Text="{Binding EffectText}" Foreground="{DynamicResource Brush.Warning}" />
                                                    </WrapPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer Visibility="{Binding IsInvestmentSection, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="新增店铺" Style="{DynamicResource PageTitleText}" />
                                <TextBlock Text="从候选店型中选择下一家店；利润方式、客流规模和风险各不相同。"
                                           TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,5,0,12" />
                                <ItemsControl x:Name="InvestmentCandidateList"
                                              ItemsSource="{Binding Investment.Candidates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Brush.SurfaceElevated}"
                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="2" Padding="10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <WrapPanel Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding ThesisText}" Foreground="{DynamicResource Brush.Primary}" FontWeight="Bold" Margin="0,0,10,0" />
                                                            <TextBlock Text="{Binding StoreContextText}" Foreground="{DynamicResource Brush.TextMuted}" />
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding TitleText}" FontWeight="Bold" FontSize="15" />
                                                        <TextBlock Text="{Binding AvailabilityText}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Tag="investment-action" Content="选择开店"
                                                            Style="{DynamicResource PrimaryPixelButton}"
                                                            Command="{Binding InvestCommand}" Margin="10,0,0,0" />
                                                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                                        <TextBlock Text="{Binding CostText}" Margin="0,0,14,0" />
                                                        <TextBlock Text="{Binding ExpectedBenefitText}" Foreground="{DynamicResource Brush.Success}" Margin="0,0,14,0" />
                                                        <TextBlock Text="{Binding PaybackText}" Foreground="{DynamicResource Brush.Primary}" />
                                                    </WrapPanel>
                                                    <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,5,0,0">
                                                        <TextBlock Text="{Binding CashAfterText}" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,14,0" />
                                                        <TextBlock Text="{Binding CashPressureText}" Foreground="{DynamicResource Brush.Warning}" />
                                                    </WrapPanel>
                                                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding EffectText}"
                                                               TextWrapping="Wrap" Margin="0,6,0,0" />
                                                    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding EstimateConditionText}"
                                                               Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Investment.StatusMessage}" Foreground="{DynamicResource Brush.Primary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="2,0,0,0">
                <ScrollViewer x:Name="RightRailScrollViewer"
                              MinWidth="260"
                              Padding="12"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <TextBlock Text="当前店铺" Style="{DynamicResource EyebrowText}" />
                    <TextBlock Text="{Binding SelectedStoreName}" Foreground="{DynamicResource Brush.Primary}" Margin="0,6,0,12" />
                    <Border x:Name="NextActionPanel"
                            Style="{DynamicResource SectionCard}"
                            BorderBrush="{DynamicResource Brush.Primary}"
                            Margin="0,0,0,12"
                            AutomationProperties.Name="当前下一步">
                        <StackPanel>
                            <TextBlock Text="{Binding NextAction.ContextText}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" />
                            <TextBlock Text="{Binding NextAction.Title}" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding NextAction.DetailText}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" Margin="0,5,0,8" />
                            <Button x:Name="NextActionButton" Content="{Binding NextAction.ActionText}"
                                    Style="{DynamicResource PrimaryPixelButton}"
                                    MinHeight="44"
                                    Command="{Binding GoToNextActionCommand}"
                                    AutomationProperties.Name="{Binding NextAction.ActionText}" />
                        </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

    </Grid>
</Window>
