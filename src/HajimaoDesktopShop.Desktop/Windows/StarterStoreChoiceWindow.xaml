<Window x:Class="HajimaoDesktopShop.Desktop.Windows.StarterStoreChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择第一家店"
        Width="960" Height="620"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="第一笔投资" Style="{DynamicResource EyebrowText}" />
            <TextBlock Text="选择你的第一家店"
                       Style="{DynamicResource PageTitleText}"
                       Margin="0,4,0,0" />
        </StackPanel>
        <TextBlock Grid.Row="1" Margin="0,8,0,14"
                   Text="先选你愿意承担的风险。店铺会自动营业，你负责经营方向和下一笔投资。"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.TextMuted}" />

        <ScrollViewer x:Name="StarterChoiceScrollViewer"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <ItemsControl x:Name="StarterStoreChoices" ItemsSource="{Binding Choices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource ChoiceCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border x:Name="StorefrontPreview"
                                        Height="112"
                                        BorderThickness="0,0,0,2"
                                        Margin="-16,-16,-16,12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Brush.SurfacePrimarySubtle}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FormatId}" Value="convenience">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.FormatConvenience}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FormatId}" Value="discount">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.FormatDiscount}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FormatId}" Value="premium">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.FormatPremium}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="18,14,18,0">
                                        <Border Height="12" VerticalAlignment="Top"
                                                Background="{DynamicResource Brush.Border}" />
                                        <Border Margin="8,10,8,0"
                                                Background="{DynamicResource Brush.Surface}"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="2">
                                            <Grid Margin="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="30" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Border Background="{DynamicResource Brush.SurfaceElevated}"
                                                        BorderBrush="{DynamicResource Brush.Primary}" BorderThickness="2"
                                                        Padding="6,2">
                                                    <TextBlock Text="{Binding BrandName}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource Brush.Primary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Border>
                                                <Grid Grid.Row="1" Margin="3,7,3,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="7" />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="7" />
                                                        <ColumnDefinition Width="22" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{DynamicResource Brush.SurfaceHover}" />
                                                    <Border Grid.Column="2" Background="{DynamicResource Brush.SurfaceHover}" />
                                                    <Border Grid.Column="4" Background="{DynamicResource Brush.PrimaryPressed}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                                <DockPanel Grid.Row="1" LastChildFill="False">
                                    <TextBlock Text="{Binding BrandName}" FontSize="20" FontWeight="Bold"
                                               TextWrapping="Wrap" />
                                    <Border DockPanel.Dock="Right"
                                            Background="{DynamicResource Brush.SurfacePrimarySubtle}"
                                            BorderBrush="{DynamicResource Brush.Primary}"
                                            BorderThickness="1"
                                            Padding="7,2">
                                        <TextBlock Text="{Binding ReturnProfileText}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Brush.Primary}" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Grid.Row="2" Margin="0,2,0,10" Text="{Binding FormatName}"
                                           Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Grid.Row="3" Text="{Binding DecisionPromptText}"
                                           Foreground="{DynamicResource Brush.Primary}"
                                           FontWeight="Bold" FontSize="16" />
                                <TextBlock Grid.Row="4" Margin="0,3,0,10" Text="{Binding EarningText}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="5" Text="主要风险" Style="{DynamicResource EyebrowText}"
                                           Foreground="{DynamicResource Brush.Warning}" />
                                <TextBlock Grid.Row="6" Margin="0,3,0,10" Text="{Binding RiskText}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.Warning}" />
                                <StackPanel Grid.Row="7">
                                    <TextBlock Text="适合你" Style="{DynamicResource EyebrowText}" />
                                    <TextBlock Margin="0,3,0,12" Text="{Binding FitText}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush.TextMuted}" />
                                </StackPanel>
                                <Button Grid.Row="8" Tag="starter-store-choice"
                                        Content="投资这家店"
                                        Style="{DynamicResource PrimaryPixelButton}"
                                        Command="{Binding SelectCommand}"
                                        AutomationProperties.HelpText="选定后创建新存档"
                                        AutomationProperties.Name="{Binding BrandName, StringFormat=选择 {0}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Margin="0,12,0,0"
                   Text="选定后才会创建存档；直接关闭将退出游戏。"
                   Foreground="{DynamicResource Brush.TextMuted}" />
    </Grid>
</Window>
