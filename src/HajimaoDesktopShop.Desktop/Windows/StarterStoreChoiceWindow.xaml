<Window x:Class="HajimaoDesktopShop.Desktop.Windows.StarterStoreChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择第一家店"
        Width="960" Height="600"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="第一笔投资" Style="{DynamicResource EyebrowText}" />
            <TextBlock Text="选择你的第一家店"
                       Style="{DynamicResource PageTitleText}"
                       Margin="0,4,0,0" />
        </StackPanel>
        <TextBlock Grid.Row="1" Margin="0,8,0,14"
                   Text="三种店都会自动处理日常运营。你只需选择回报方式，之后观察经营并决定下一笔投资。"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.TextMuted}" />

        <ScrollViewer x:Name="StarterChoiceScrollViewer"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <ItemsControl x:Name="StarterStoreChoices" ItemsSource="{Binding Choices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource ChoiceCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding BrandName}" FontSize="20" FontWeight="Bold"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Margin="0,3,0,14" Text="{Binding FormatName}"
                                           Foreground="{DynamicResource Brush.Primary}" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Text="赚钱方式" Style="{DynamicResource EyebrowText}" />
                                <TextBlock Grid.Row="3" Margin="0,3,0,12" Text="{Binding EarningText}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="4" Text="主要风险" Style="{DynamicResource EyebrowText}"
                                           Foreground="{DynamicResource Brush.Warning}" />
                                <TextBlock Grid.Row="5" Margin="0,3,0,12" Text="{Binding RiskText}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.Warning}" />
                                <StackPanel Grid.Row="6">
                                    <TextBlock Text="适合你" Style="{DynamicResource EyebrowText}" />
                                    <TextBlock Margin="0,3,0,14" Text="{Binding FitText}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush.TextMuted}" />
                                </StackPanel>
                                <Button Grid.Row="7" Tag="starter-store-choice"
                                        Content="以此开始"
                                        Style="{DynamicResource PrimaryPixelButton}"
                                        Command="{Binding SelectCommand}"
                                        AutomationProperties.HelpText="选定后创建新存档"
                                        AutomationProperties.Name="{Binding BrandName, StringFormat=选择 {0}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Margin="0,12,0,0"
                   Text="选定后才会创建存档；直接关闭将退出游戏。"
                   Foreground="{DynamicResource Brush.TextMuted}" />
    </Grid>
</Window>
