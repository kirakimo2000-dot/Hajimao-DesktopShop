<Window x:Class="HajimaoDesktopShop.Desktop.Windows.StarterStoreChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择第一家店"
        Width="900" Height="480"
        MinWidth="900" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="从一家店开始你的街区"
                   FontSize="25" FontWeight="Bold"
                   Foreground="{DynamicResource Brush.Primary}" />
        <TextBlock Grid.Row="1" Margin="0,6,0,16"
                   Text="选一种赚钱方式。店内细节会自动运转，之后仍可在街道扩张其他类型。"
                   Foreground="{DynamicResource Brush.TextMuted}" />

        <ItemsControl x:Name="StarterStoreChoices" Grid.Row="2" ItemsSource="{Binding Choices}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{DynamicResource PixelPanel}" Margin="0,0,10,0" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding BrandName}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Grid.Row="1" Margin="0,2,0,12" Text="{Binding FormatName}"
                                       Foreground="{DynamicResource Brush.Primary}" />
                            <TextBlock Grid.Row="2" Text="{Binding EarningText}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" Margin="0,10,0,0" Text="{Binding RiskText}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Warning}" />
                            <TextBlock Grid.Row="4" Margin="0,10,0,12" Text="{Binding FitText}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.TextMuted}" />
                            <Button Grid.Row="5" Tag="starter-store-choice"
                                    Content="选择这家店"
                                    Style="{DynamicResource PrimaryPixelButton}"
                                    Command="{Binding SelectCommand}"
                                    AutomationProperties.Name="{Binding BrandName, StringFormat=选择 {0}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="3" Margin="0,12,0,0"
                   Text="关闭窗口将退出，新存档只会在你选定后创建。"
                   Foreground="{DynamicResource Brush.TextMuted}" />
    </Grid>
</Window>
